/*
  # ================================================================
  # HTTP SECURITY RESPONSE HEADERS
  # JABIR MAHMUD KAWSAR — Graphic Design Portfolio
  #
  # This file is served by Netlify, Cloudflare Pages, or any host
  # that supports _headers files.
  #
  # GitHub Pages does NOT support custom HTTP headers via _headers.
  # For GitHub Pages, these headers are documented in DEPLOYMENT_GUIDE.md
  # and the meta-tag equivalents in index.html provide defense-in-depth.
  # ================================================================

  # Prevent MIME-type sniffing attacks
  X-Content-Type-Options: nosniff

  # Strict HTTPS enforcement (enforced by HTTPS-only hosts automatically)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Prevent clickjacking — this site should never appear in an iframe
  X-Frame-Options: DENY

  # Control referrer information sent to external sites
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict browser feature access — deny unnecessary powerful APIs
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()

  # Content-Security-Policy — tuned for this portfolio's actual requirements:
  # - Google Fonts (fonts.googleapis.com, fonts.gstatic.com)
  # - Images from self, data URIs, and HTTPS (Behance CDN thumbnails if added)
  # - No frames, no plugins, no eval
  # - mailto: allowed in form-action for the contact form
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:;

  # Legacy XSS protection for older browsers (not a substitute for CSP)
  X-XSS-Protection: 1; mode=block

  # Prevent cross-origin isolation issues
  Cross-Origin-Opener-Policy: same-origin-allow-popups
